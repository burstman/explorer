package landing

import (
	"explorer/app/types"
	"fmt"
)

templ Gallerie(images []types.ImageWithComments) {
	<section class="relative min-h-screen">
		<!-- Background -->
		<div
			class="absolute inset-0 bg-cover bg-center"
			style="background-image: url('https://images.unsplash.com/photo-1500673922987-e212871fec22?auto=format&fit=crop&w=2000&q=80')"
		>
			<div class="absolute inset-0 bg-gradient-to-b from-black/60 to-black/30"></div>
		</div>
		<!-- Content -->
		<div class="relative max-w-6xl mx-auto py-12 px-4 z-10">
			<h1 class="text-4xl font-bold text-center text-white mb-10 drop-shadow">
				Our Explorers Moments
			</h1>
			<!-- Upload Button -->
			<div class="flex justify-center mb-8">
				<button
					type="button"
					@click="modalOpen = true"
					hx-get="/gallery/upload"
					hx-target="#modal-content"
					hx-swap="innerHTML"
					class="bg-green-600 text-white px-6 py-2 rounded-lg shadow hover:bg-green-700 transition"
				>
					Upload New Photo
				</button>
			</div>
			<!-- Gallery Grid -->
			<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8">
				for _, img := range images {
					<div class="bg-white rounded-2xl shadow-md overflow-hidden">
						<img
							src={ "/uploads/" + img.Filename }
							alt="Explorer photo"
							class="w-full h-64 object-cover"
						/>
						<div class="p-4 space-y-3">
							<h2 class="font-semibold text-lg text-green-900">{ img.Title }</h2>
							<p class="text-gray-600 text-sm">{ img.Description }</p>
							<!-- Comments -->
							<div class="border-t pt-2 mt-2">
								<h3 class="text-sm font-medium text-gray-800 mb-1">Comments</h3>
								if len(img.Comments) == 0 {
									<p class="text-gray-400 text-sm">No comments yet.</p>
								} else {
									<ul class="space-y-1">
										for _, comment := range img.Comments {
											<li class="text-sm text-gray-700">
												<span class="font-semibold">{ comment.UserName }:</span> { comment.Content }
											</li>
										}
									</ul>
								}
								<!-- Add new comment form -->
								<form
									hx-post={ "/gallery/comment/" + fmt.Sprint(img.ID) }
									class="mt-3 space-y-2"
								>
									<textarea
										name="content"
										placeholder="Add a comment..."
										class="w-full border rounded-lg p-2 text-sm focus:ring focus:ring-green-300"
									></textarea>
									<button
										type="submit"
										class="bg-green-600 text-white px-3 py-1 rounded hover:bg-green-700 text-sm"
									>
										Post
									</button>
								</form>
							</div>
						</div>
					</div>
				}
			</div>
		</div>
	</section>
}

templ GalleryUploadForm(galleries []types.Gallery) {
	<div
		x-data="galleryForm()"
		class="relative bg-white p-6 rounded-2xl shadow-xl max-w-xl mx-auto"
	>
		<!-- Close button -->
		<button
			@click="modalOpen = false"
			class="absolute top-2 right-2 text-gray-600 hover:text-red-600 text-2xl font-bold"
		>
			×
		</button>
		<h2 class="text-xl font-semibold mb-4 text-gray-800">Upload Gallery</h2>
		<form @submit.prevent="submitForm" enctype="multipart/form-data" class="space-y-4">
			<!-- Select existing gallery -->
			<div>
				<label class="block text-sm font-medium text-gray-700">Select Existing Gallery</label>
				<select
					x-model="selectedGalleryId"
					class="w-full border rounded-lg px-3 py-2 mt-1 focus:ring-2 focus:ring-green-500 focus:outline-none"
				>
					<option value="">-- New Gallery --</option>
					for _, gallery := range galleries {
						<option value={ gallery.ID }>{ gallery.Title }</option>
					}
				</select>
			</div>
			<!-- New gallery inputs only if no existing gallery is selected -->
			<div x-show="!selectedGalleryId">
				<div class="mt-2">
					<label class="block text-sm font-medium text-gray-700">New Gallery Title</label>
					<input
						type="text"
						x-model="title"
						class="w-full border rounded-lg px-3 py-2 mt-1 focus:ring-2 focus:ring-green-500 focus:outline-none"
						placeholder="Enter gallery title"
					/>
				</div>
				<div class="mt-2">
					<label class="block text-sm font-medium text-gray-700">Description</label>
					<textarea
						x-model="description"
						class="w-full border rounded-lg px-3 py-2 mt-1 focus:ring-2 focus:ring-green-500 focus:outline-none"
						placeholder="Enter gallery description"
					></textarea>
				</div>
			</div>
			<!-- File upload -->
			<div>
				<label class="block text-sm font-medium text-gray-700">Select Images</label>
				<input
					type="file"
					multiple
					@change="handleFiles"
					class="w-full border rounded-lg px-3 py-2 mt-1 focus:ring-2 focus:ring-green-500 focus:outline-none"
				/>
				<!-- Preview thumbnails -->
				<div class="flex flex-wrap gap-2 mt-3">
					<template x-for="(file, index) in files" :key="index">
						<div class="relative">
							<img
								:src="file.preview"
								class="w-24 h-24 object-cover rounded-lg border"
							/>
							<button
								type="button"
								@click="removeFile(index)"
								class="absolute top-0 right-0 bg-red-500 text-white text-xs px-1 rounded-full"
							>×</button>
						</div>
					</template>
				</div>
			</div>
			<button
				type="submit"
				:disabled="loading"
				class="bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-lg font-semibold transition"
			>
				<span x-show="!loading">Upload Gallery</span>
				<span x-show="loading">Uploading...</span>
			</button>
			<p x-text="message" class="text-sm text-gray-600 mt-2"></p>
		</form>
	</div>
	<script>
	function galleryForm() {
	  return {
	    selectedGalleryId: '',
	    title: '',
	    description: '',
	    files: [],
	    message: '',
	    loading: false,
	    modalOpen: true,

	    handleFiles(e) {
	      this.files = Array.from(e.target.files).map(file => ({
	        file,
	        preview: URL.createObjectURL(file)
	      }))
	    },

	    removeFile(index) {
	      this.files.splice(index, 1)
	    },

	    async submitForm() {
	      if (!this.files.length) {
	        this.message = "Please select at least one image."
	        return
	      }

	      this.loading = true
	      this.message = ''

	      const formData = new FormData()
	      if (this.selectedGalleryId) {
	        formData.append('gallery_id', this.selectedGalleryId)
	      } else {
	        formData.append('title', this.title)
	        formData.append('description', this.description)
	      }

	      this.files.forEach(f => formData.append('images', f.file))

	      try {
	        const res = await fetch('/gallery/upload', {
	          method: 'POST',
	          body: formData
	        })

	        const data = await res.json()

	        if (!res.ok) throw new Error(data.error || 'Upload failed')

	        this.message = data.status === 'success' ? "Gallery uploaded successfully!" : "Upload completed"
	        this.files = []
	        this.title = ''
	        this.description = ''
	        this.selectedGalleryId = ''

	        console.log("Gallery:", data.gallery)
	        console.log("Images:", data.images)

	      } catch (err) {
	        this.message = "Upload failed: " + err.message
	      } finally {
	        this.loading = false
	      }
	    }
	  }
	}
	</script>
}
